# Production environment configuration.
#
# Base URL of the PROD visitor-counter REST API (AWS API Gateway staged endpoint).
# Read at build time by docusaurus.config.ts when APP_ENV=prod (e.g. via the
# `build:prod` / `start:prod` npm scripts) and exposed to the client bundle via
# customFields.visitorCounterApiBaseUrl.
#
# IMPORTANT: keep the trailing slash — the staged API Gateway endpoint requires
# it to resolve. If this is unset, the config falls back to an empty value and
# the visitor counter is hidden.
#
# Copy this file to `.env.prod` and fill in the value to emulate prod locally:
#   cp .env.prod.example .env.prod
VISITOR_COUNTER_API_BASE_URL=https://[yourProdAPI].execute-api.ap-southeast-2.amazonaws.com/prod/
