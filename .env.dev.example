# Development environment configuration.
#
# Base URL of the DEV visitor-counter REST API (AWS API Gateway staged endpoint).
# Read at build time by docusaurus.config.ts (when APP_ENV is unset or 'dev')
# and exposed to the client bundle via customFields.visitorCounterApiBaseUrl.
#
# IMPORTANT: keep the trailing slash — the staged API Gateway endpoint requires
# it to resolve. If this is unset, the config falls back to an empty value and
# the visitor counter is hidden.
#
# Copy this file to `.env.dev` and fill in the value for local development:
#   cp .env.dev.example .env.dev
VISITOR_COUNTER_API_BASE_URL=https://[yourDevAPI].execute-api.ap-southeast-2.amazonaws.com/dev/
