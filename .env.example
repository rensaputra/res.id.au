# Environment selection is driven by APP_ENV (default: dev).
#
# Local builds load `.env.${APP_ENV}` first, then fall back to a plain `.env`.
# Use the per-environment example files instead of this one:
#
#   cp .env.dev.example .env.dev     # loaded by `npm start` / `npm run build`
#   cp .env.prod.example .env.prod   # loaded by `npm run start:prod` / `npm run build:prod`
#
# A plain `.env` (copied from either example below) still works as a fallback
# when the mode-specific file is absent.
#
# Base URL of the visitor-counter REST API (AWS API Gateway staged endpoint).
# Read at build time by docusaurus.config.ts and exposed to the client bundle
# via customFields.visitorCounterApiBaseUrl.
#
# IMPORTANT: keep the trailing slash — the staged API Gateway endpoint requires
# it to resolve.
VISITOR_COUNTER_API_BASE_URL=https://[yourAPI].execute-api.ap-southeast-2.amazonaws.com/dev/
